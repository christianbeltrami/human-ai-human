# ── human-ai-human.org — Environment Variables ────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── OpenAI (AI troll filter) ───────────────────────────────────
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── AI Creativity Roulette personalization (disabled by default) ─
ENABLE_OPENAI_PERSONALIZATION=false
OPENAI_MODEL=
MAX_PERSONALIZATIONS_PER_VISITOR_PER_DAY=3
MAX_GLOBAL_PERSONALIZATIONS_PER_DAY=2000
MAX_GLOBAL_PERSONALIZATIONS_PER_MONTH=20000
CURATION_GATE_URL=
AI_CREATIVITY_GUIDE_URL=

# ── Resend (transactional email) ───────────────────────────────
# Get at: https://resend.com/api-keys
RESEND_API_KEY=re_...

# ── Contact email (where filtered questions are sent) ──────────
CONTACT_EMAIL=humancontact@human-ai-human.org

# ── Airtable (question storage + audit log) ────────────────────
# Token: https://airtable.com/create/tokens
# Base ID: visible in the URL when you open your base (appXXXXXXXX)
# Table ID: name of your table or its ID (tblXXXXXXXX)
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_ID=Questions

# ── TinaCMS Cloud ──────────────────────────────────────────────
# Get at: https://app.tina.io → your project → Settings
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# ── Umami Analytics ───────────────────────────────────────────
# After creating your site on cloud.umami.is, paste the website ID here.
# Then uncomment the script tag in BaseLayout.astro.
UMAMI_WEBSITE_ID=
