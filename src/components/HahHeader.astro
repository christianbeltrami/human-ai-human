---
// HahHeader — SVG signature graphic: human → AI → human
// Left "Human →" and right "human" use the handwritten PNG (925×303, transparent bg)
// Arrow from PNG covers left side; right side crops the PNG to hide the arrow
---
<a href="/" style="text-decoration:none; display:block;" aria-label="human-ai-human — home">
  <svg
    viewBox="0 0 362 68"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    style="max-width: 362px; width: 100%; display: block;"
  >
    <defs>
      <!-- Recolor black ink to accent red, preserving transparency -->
      <filter id="ink-red" color-interpolation-filters="sRGB">
        <feFlood flood-color="#F93C20" result="color"/>
        <feComposite in="color" in2="SourceGraphic" operator="in"/>
      </filter>
      <!-- Clip right "human" image to hide the arrow portion -->
      <clipPath id="human-only">
        <rect x="252" y="0" width="103" height="68"/>
      </clipPath>
    </defs>

    <!-- "Human →" left — full handwritten PNG (includes handwritten arrow) -->
    <image
      href="/images/human-handwriting.png"
      x="0" y="8" width="159" height="52"
      filter="url(#ink-red)"
    />

    <!-- "AI" centre — bold serif -->
    <text
      x="163" y="49"
      font-family="'Noto Serif', ui-serif, Georgia, serif"
      font-size="22"
      font-weight="700"
      fill="#F93C20"
    >AI</text>

    <!-- arrow 2 (SVG) -->
    <line x1="201" y1="41" x2="232" y2="41" stroke="#F93C20" stroke-width="1.5"/>
    <polygon points="232,36 244,41 232,46" fill="#F93C20"/>

    <!-- "human" right — same PNG, clipped to word only (no arrow) -->
    <image
      href="/images/human-handwriting.png"
      x="252" y="8" width="159" height="52"
      filter="url(#ink-red)"
      clip-path="url(#human-only)"
    />
  </svg>
</a>
