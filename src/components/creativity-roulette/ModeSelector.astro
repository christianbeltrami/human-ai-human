<fieldset class="cr-mode" aria-label="Choose your creative temperature">
  <legend>Choose your creative temperature</legend>
  <div class="cr-mode-options">
    <label class="cr-mode-option">
      <input type="radio" name="creativity-mode" value="useful" checked />
      <span>Useful</span>
    </label>
    <label class="cr-mode-option">
      <input type="radio" name="creativity-mode" value="weird" />
      <span>Weird</span>
    </label>
    <label class="cr-mode-option">
      <input type="radio" name="creativity-mode" value="wild" />
      <span>Wild</span>
    </label>
  </div>
  <p class="cr-mode-help">Useful moves you forward. Weird breaks your pattern. Wild changes the frame.</p>
</fieldset>
