---
import BaseLayout from './BaseLayout.astro';
import TagPill from '../components/TagPill.astro';
import SubscribeInline from '../components/SubscribeInline.astro';
import ChristianSignature from '../components/ChristianSignature.astro';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  lang?: 'fr' | 'en';
  excerpt?: string;
  author?: string;
  hideSignature?: boolean;
  seoTitle?: string;
  description?: string;
  modified?: Date;
}

const {
  title,
  date,
  tags = [],
  lang = 'fr',
  excerpt,
  author,
  hideSignature = false,
  seoTitle,
  description,
  modified,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-CA' : 'en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(date));

const metaDescription = description ?? excerpt;
---
<BaseLayout
  title={title}
  description={metaDescription}
  seoTitle={seoTitle}
  publishedTime={date}
  modifiedTime={modified ?? date}
  lang={lang}
>
  <slot name="head" slot="head" />
  <article>
    <a href="/" class="back-link">← All articles</a>

    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={new Date(date).toISOString()}>{formattedDate}</time>
        {lang && (
          <span class="lang-badge">{lang.toUpperCase()}</span>
        )}
        {author && <span style="color:var(--text-secondary);">{author}</span>}
        {tags.length > 0 && (
          <div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
            {tags.map(tag => <TagPill tag={tag} />)}
          </div>
        )}
      </div>
    </header>

    <div class="post-body">
      <slot />
    </div>

    {!hideSignature && (
      <div class="post-signature" aria-hidden="true">
        <ChristianSignature />
      </div>
    )}

    <SubscribeInline />
  </article>
</BaseLayout>
