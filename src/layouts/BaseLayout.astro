---
import '../styles/global.css';
import HahHeader from '../components/HahHeader.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  seoTitle?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  lang?: 'fr' | 'en';
}

const {
  title = 'human-ai-human',
  description = 'Notes on creative AI, cinema, and human collaboration — by Christian Beltrami.',
  ogImage = '/og-default.png',
  seoTitle,
  publishedTime,
  modifiedTime,
  lang = 'fr',
} = Astro.props;

const defaultSiteTitle = title === 'human-ai-human' ? title : `${title} — human-ai-human`;
const siteTitle = seoTitle ?? defaultSiteTitle;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogType = publishedTime ? 'article' : 'website';
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    {publishedTime && (
      <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />
    )}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="human-ai-human RSS" href="/rss.xml" />

    <!-- Umami Analytics — cookie-free, GDPR-friendly -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="60475f9b-09ca-4103-b1d9-5f69864411e5"></script>

    <title>{siteTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <HahHeader />
        <p style="margin: 0.5rem 0 0; color:var(--text-secondary); font-size:0.9rem; font-style:italic;">Field notes from teaching AI + creativity: documenting what we're building, what we're testing, and what students teach me along the way.</p>
        <nav class="site-nav">
          <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
            <a href="/" style="font-size:0.75rem; color:var(--text-secondary);">Articles</a>
            <a href="/tags" style="font-size:0.75rem; color:var(--text-secondary);">Tags</a>
            <a href="/#questions" style="font-size:0.75rem; color:var(--text-secondary);">Ask a question</a>
            <a href="/merch" style="font-size:0.75rem; color:var(--text-secondary);">Merch</a>
            <a href="/courses" style="font-size:0.75rem; color:var(--text-secondary);">Current Courses</a>
            <a href="/posts/free-open-ai-video-generators-student-guide" style="font-size:0.75rem; color:var(--text-secondary);">Resources</a>
          </div>
          <button
            class="theme-toggle"
            id="theme-toggle"
            aria-label="Toggle dark/light mode"
          >
            ◐
          </button>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>
          <a href="https://human-ai-human.org">human-ai-human.org</a>
        </p>
      </footer>
    </div>

    <script>
      // Theme toggle — respects system preference, allows manual override
      const STORAGE_KEY = 'hah-theme';
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');

      function getPreferredTheme(): 'dark' | 'light' {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored === 'dark' || stored === 'light') return stored;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function applyTheme(theme: 'dark' | 'light') {
        root.setAttribute('data-theme', theme);
        if (btn) btn.textContent = theme === 'dark' ? '○' : '◐';
      }

      applyTheme(getPreferredTheme());

      btn?.addEventListener('click', () => {
        const current = root.getAttribute('data-theme') as 'dark' | 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        localStorage.setItem(STORAGE_KEY, next);
        applyTheme(next);
      });
    </script>
  </body>
</html>
