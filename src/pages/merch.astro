---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Merch" description="human-ai-human merchandise — limited edition t-shirt.">
  <div class="merch-page">
    <h1 class="merch-title">Merch</h1>
    <div class="product">
      <div class="product-image-wrap">
        <img
          src="/images/tshirt.png"
          alt="human → AI → human t-shirt, black"
          class="product-image"
        />
        <span class="sold-out-badge">Not available</span>
      </div>
      <div class="product-info">
        <p class="product-name">human → AI → human</p>
        <p class="product-desc">T-shirt — black, unisex</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .merch-page {
    padding: 3rem 0 6rem;
  }

  .merch-title {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-weight: 400;
    margin: 0 0 3rem;
  }

  .product {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .product-image-wrap {
    position: relative;
    display: inline-block;
    max-width: 520px;
    width: 100%;
  }

  .product-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }

  .sold-out-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--bg);
    color: var(--text-secondary);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--text-secondary);
    border-radius: 2px;
    opacity: 0.85;
  }

  .product-info {
    text-align: center;
  }

  .product-name {
    font-size: 1rem;
    color: var(--text-primary);
    margin: 0 0 0.25rem;
  }

  .product-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    font-style: italic;
  }
</style>
