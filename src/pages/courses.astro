---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Past Courses" description="Courses taught by Christian Beltrami on AI and creativity.">
  <div class="courses-page">
    <h1 class="courses-title">Past Courses</h1>
    <div class="course-item">
      <p class="course-desc">A project-based studio course at Concordia University exploring generative AI as a collaborative creative tool — across film, design, media arts, and music composition.</p>
      <a
        href="https://www.concordia.ca/finearts/academics/summer/ai-creativity-intensive.html"
        target="_blank"
        rel="noopener"
        class="course-link"
      >
        AI and Creativity Summer Intensive — Concordia University
      </a>
      <p class="course-dates">May 11 – June 1, 2026</p>
    </div>

    <div class="course-resources">
      <h2 class="course-resources-title">Resources</h2>
      <p class="course-resource-item">
        <a href="/resources" class="course-link">
          Independent references and catalogues
        </a>
        <span class="course-resource-desc"> — written for students, but open to anyone: catalogues of tools, formats, and workflows, with policy, privacy, consent, and likeness-risk notes where they matter. These are offered freely, not as an official companion to any course. Nothing there is a Concordia resource, an approved-tool list, or permission to use AI in coursework.</span>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .courses-page {
    padding: 3rem 0 6rem;
  }

  .courses-title {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-weight: 400;
    margin: 0 0 3rem;
  }

  .course-item {
    max-width: 65ch;
  }

  .course-desc {
    margin: 0 0 1rem;
  }

  .course-link {
    display: inline-block;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    transition: opacity 0.15s;
  }

  .course-link:hover {
    opacity: 0.75;
  }

  .course-dates {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .course-resources {
    max-width: 65ch;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .course-resources-title {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-weight: 400;
    margin: 0 0 1.25rem;
  }

  .course-resource-item {
    margin: 0;
  }

  .course-resource-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
</style>
